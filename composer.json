{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "yukazakiri/lepton-agent",
    "description": "Community-maintained Laravel-first PHP SDK for Circle wallets and Arc: typed gateways, HTTP/CLI transports, verified notifications, and testing fakes.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/yukazakiri/lepton-agent",
    "keywords": ["laravel", "circle", "arc", "usdc", "agents", "x402"],
    "authors": [
        {
            "name": "yukazakiri",
            "email": "marianolouis18@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-openssl": "*",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "orchestra/testbench": "^11.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Yukazakiri\\Lepton\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yukazakiri\\Lepton\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yukazakiri\\Lepton\\LeptonServiceProvider"
            ],
            "aliases": {
                "Lepton": "Yukazakiri\\Lepton\\Facades\\Lepton"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
